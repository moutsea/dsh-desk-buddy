{
  "name": "deepseek-girl",
  "version": "0.12.0",
  "private": true,
  "author": "DeepSeek Girl contributors",
  "license": "UNLICENSED",
  "description": "DeepSeek 娘：住在桌面上的 DSH 对话与任务入口",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke-ui.mjs",
    "test:motion": "node scripts/smoke-motion.mjs",
    "register:motion": "node scripts/register-motion.mjs",
    "pack": "npm run build && node scripts/icon.mjs && electron-builder --dir",
    "check:dsh": "node scripts/check-dsh.mjs",
    "test:size": "node scripts/smoke-size.mjs",
    "test:drag": "node scripts/smoke-drag.mjs",
    "test:completion": "node scripts/smoke-completion.mjs",
    "pack:plugin": "npm run pack && node scripts/pack-plugin.mjs",
    "test:plugin": "node scripts/smoke-plugin.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "test:stream": "node scripts/smoke-stream.mjs"
  },
  "build": {
    "icon": "build/icon.png",
    "appId": "com.deepseek.girl",
    "productName": "DeepSeek Girl",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
